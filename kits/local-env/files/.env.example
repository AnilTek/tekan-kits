# Yerel ortam (make env-up bunu .env'e kopyalar). Değerler yalnız yerel içindir: prod'a bağlanmaz, sır içermez.
# Port seçimi: <PLACEHOLDER: seçilen portlar ve neden seçildikleri (hangi projelerle çakışmasın), bir satır>
PG_PORT=<PLACEHOLDER: boş ve projeye özgü host portu>
POSTGRES_USER=<PLACEHOLDER: kısa proje adı>
POSTGRES_PASSWORD=local
POSTGRES_DB=<PLACEHOLDER: kısa proje adı>
# Yukarıdaki değerlerle aynı bileşenlerden kurulur: postgres://USER:PASSWORD@localhost:PG_PORT/DB
DATABASE_URL=<PLACEHOLDER: yerel bağlantı adresi>

# Dış servisler: her biri <SERVICE>_BASE_URL. Değer yerel mock adresidir; gerçek adres ve maliyet yorumda.
# Mock compose'ta ayrı servistir ve portu orada yayımlanır (assets/scripts/env-check.sh denetler).
# Bilerek gerçek servise gidiyorsa satırın sonuna "# env-check: real" yaz, maliyetini de belirt.
# Örnek: PAYMENTS_BASE_URL=http://localhost:<mock portu>  # real: <gerçek adres>  costs: <maliyet>
